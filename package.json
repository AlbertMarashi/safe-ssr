{
  "name": "safe-ssr",
  "version": "0.0.13",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint ."
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./safe_request_wrapper": {
      "types": "./dist/safe_request_wrapper.d.ts",
      "svelte": "./dist/safe_request_wrapper.js"
    },
    "./async_store": {
      "types": "./dist/async_store.d.ts",
      "default": "./dist/async_store.js"
    },
    "./request_symbol": {
      "types": "./dist/request_symbol.d.ts",
      "default": "./dist/request_symbol.js"
    },
    "./data_store": {
      "types": "./dist/data_store.d.ts",
      "default": "./dist/data_store.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0-next.1",
    "@sveltejs/kit": "^2.5.24"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/eslint": "^9.6.1",
    "eslint": "^9.17.0",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "publint": "^0.1.16",
    "@types/node": "^22.10.5",
    "svelte": "^5.16.5",
    "svelte-check": "^3.8.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^5.4.11",
    "@stylistic/eslint-plugin-ts": "^2.12.1"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "devalue": "^5.1.1"
  }
}